rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is signed in
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper function to check if user is admin
    function isAdmin() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.userRole == 'admin';
    }

    // User documents - users can only read/write their own
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update, delete: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    // Products - anyone can read, authenticated users can write (for seeding), admins have full access
    match /products/{productId} {
      allow read: if true;
      allow create: if true; // Allow creation for initial seeding
      allow update, delete: if isSignedIn(); // Require authentication for updates/deletes
    }

    // Orders - users can read their own, admins can read all
    match /orders/{orderId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.writeFields.keys().hasAll(['userId', 'items', 'total']);
      allow update: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // User subcollection - orders stored under users/{userId}/orders/{orderId}
    match /users/{userId}/orders/{orderId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    // Coupons - anyone can read to validate, allow creation for seeding
    match /coupons/{couponId} {
      allow read: if true;
      allow create: if true; // Allow creation for initial seeding
      allow update, delete: if isSignedIn(); // Require authentication for updates/deletes
    }

    // Default deny for anything not explicitly allowed
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
